# Graph store (local Docker now; swap these 3 for Aura later — no code change)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# LLM provider (anthropic implemented; openai/ollama are stubs)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-sonnet-4-6

# Embedder: "local" (sentence-transformers, free) or "openai" (text-embedding-3)
EMBEDDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For EMBEDDER=openai: set EMBEDDING_MODEL=text-embedding-3-small and the key below.
# (Keep comments on their OWN lines — dotenv reads everything after '=' as the value.)
# Real OpenAI key — OpenRouter does NOT serve embeddings.
OPENAI_API_KEY=sk-...
# Optional; leave blank for the OpenAI default endpoint.
OPENAI_BASE_URL=
# 0 = model's native dim (1536 for 3-small); >0 truncates (text-embedding-3 only).
EMBEDDING_DIM=0

# Tuning
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=200
MAX_PDF_PAGES=0          # 0 = no cap; set e.g. 30 to cap the 161-page EET for cost
